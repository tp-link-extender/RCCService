# Copy to .env in this directory. Every value is read at startup; the Orbiter refuses to run with a missing or bad one

# one key for every call between the Site and the Orbiter, in both directions. At least 16 characters.
# Set the same value as ORBITER_KEY in the Site's environment. It is never put in mercury.core.ts
ORBITER_KEY=replace-me-with-a-long-random-key

# the public domain. Production serves the status streams on gs.{DOMAIN}
DOMAIN=localhost:5173
# the Site's address for its serve, place and render callbacks: a scheme, and no trailing slash
SITE_URL=http://localhost:5173
# setup.{Domain} from mercury.core.ts, the client files are downloaded from here
SETUPDOMAIN=setup.mercs.dev

# ENV=dev serves the status streams on :64992 over plain HTTP. Anything else is production
ENV=dev

# how many jobs (renders or hosted gameservers) a single RCCService instance may hold
MAX_JOBS_PER_RCC=3
# the first RCCService instance binds this port, subsequent instances use higher ports
RCC_BASE_PORT=64989
# hosting job expiration in seconds. Set to e.g. 300 for short-lived leases renewed every 150s, or to 0 for a practically permanent job that is closed explicitly with CloseJob
HOST_EXPIRATION=300

# engine used when a start has no ?engine= query param: "studio" (2013 Studio) or "rcc" (RCCService jobs)
# DEFAULT_ENGINE=rcc
# the RCC map to load for hosted places, "none" skips the map. Unset loads each place from the Site
# RCC_MAP_LOCATION=none
# how RCCService instances are started: "direct" (a child process) or "detached" (Windows, tracked by pid)
# RCC_SPAWN=direct
