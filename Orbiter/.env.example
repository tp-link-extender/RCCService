ENV=dev
DOMAIN=localhost:5173
# where the Site's rbxclient routes are, if not http://www.{DOMAIN}
# SITE_URL=http://localhost:5173
# setup.{Domain} from mercury.core.ts, the host clients are downloaded from
SETUPDOMAIN=setup.mercs.dev
IPV4=127.0.0.1
IPV6=::1
GAMESERVER_KEY=password
# engine used when no ?engine= query param is present in PUT /{id} ("studio" or "rcc")
DEFAULT_ENGINE=studio
# the RCC proxy (spawns and load balances RCCService instances). Keep in step with RCCServiceProxyURL in mercury.core.ts
PROXY_URL=http://localhost:64990
# proxy key for authenticating to the RCC proxy's host route
PROXY_KEY=password
