IP=::1
ENDPOINT=https://mercs.dev/api/render/update
RCC_KEY=password
# auth for the Orbiter's requests to /host and DELETE /host (empty = loopback/IP only)
PROXY_KEY=password
# how many jobs (renders or hosted gameservers) a single RCCService instance may hold
MAX_JOBS_PER_RCC=3
# the first RCCService instance binds this port, subsequent instances use higher ports
RCC_BASE_PORT=64989
# hosting job expiration. Set to e.g. 300 for short-lived leases renewed via RenewLease
# (strategy 1), or to 0 for a practically permanent job that is closed explicitly with
# CloseJobEx (strategy 2)
HOST_EXPIRATION=300
# Orbiter's private hoststatus route, where hosted server statuses are relayed to
HOST_ENDPOINT=http://localhost:64991/hoststatus
